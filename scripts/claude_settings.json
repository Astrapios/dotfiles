{
  "env": {
    "CLAUDE_CODE_DISABLE_MOUSE": "1"
  },
  "model": "claude-fable-5-1[1m]",
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/bin/astra\" hook"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/bin/astra\" hook"
          }
        ]
      }
    ],
    "PreToolUse": [
