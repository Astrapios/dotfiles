        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/bin/astra\" hook"
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/bin/astra\" hook"
          }
        ]
      },
      {
        "matcher": "EnterPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/bin/astra\" hook"
